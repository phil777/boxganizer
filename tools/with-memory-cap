#!/usr/bin/env bash
# Run a command inside its own memory-capped systemd scope.
#
# The suite is run this way so that a runaway test is killed by its own cgroup
# instead of the global OOM killer, which would take the whole session with it.
#
#   tools/with-memory-cap [--limit 1200M] -- .venv/bin/python -m pytest -q
#
# Exit status is the command's; a process the kernel killed for memory exits 137.
set -uo pipefail

LIMIT="${MEMORY_LIMIT:-1200M}"
while [ $# -gt 0 ]; do
  case "$1" in
    --limit) LIMIT="$2"; shift 2 ;;
    --) shift; break ;;
    *) break ;;
  esac
done
if [ $# -eq 0 ]; then
  echo "usage: tools/with-memory-cap [--limit SIZE] -- COMMAND [ARGS...]" >&2
  exit 2
fi

exec systemd-run --user --quiet --scope --collect \
  --property="MemoryMax=${LIMIT}" \
  --property="MemorySwapMax=0" \
  --property="TasksMax=256" -- "$@"
